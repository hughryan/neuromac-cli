# Personal identity (included first — repo settings below take precedence on conflicts)
[include]
    path = ~/.gitconfig-personal

[core]
    editor = hx
    pager = delta
    excludesfile = ~/.gitignore_global
    autocrlf = input

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true
    prunetags = true

[rebase]
    autoStash = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[delta]
    navigate = true
    line-numbers = true
    syntax-theme = base16
    plus-style = "syntax #0d2618"
    minus-style = "syntax #2a0d14"
    plus-emph-style = "syntax bold #1a4d2a"
    minus-emph-style = "syntax bold #4d1a27"
    line-numbers-plus-style = "#50ffaa"
    line-numbers-minus-style = "#ff6090"
    line-numbers-zero-style = "#3a4a5c"
    hunk-header-style = "file line-number syntax"
    hunk-header-file-style = "#44f5e5"
    hunk-header-line-number-style = "#e07aff"
    hunk-header-decoration-style = "#1a2535 box"

[interactive]
    diffFilter = delta --color-only

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate
    lga = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    unstage = restore --staged
